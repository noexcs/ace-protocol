{
	"name": "ace-runtime",
	"version": "0.1.0",
	"description": "ACE (Agent Context Event Protocol) 0.1 runtime: external events into an agent's context",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./extension": "./extensions/ace.ts",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"extensions",
		"schema",
		"README.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"example:basic": "node examples/basic.ts",
		"example:redis": "node examples/redis-streams.ts"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.0.1",
		"@earendil-works/pi-ai": "1.0.1",
		"@earendil-works/pi-coding-agent": "1.0.1",
		"redis": "6.3.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"keywords": [
		"ace",
		"agent",
		"event",
		"protocol",
		"pi"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/noexcs/ace-protocol.git",
		"directory": "packages/ace-runtime"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
