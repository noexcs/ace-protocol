{
	"name": "ace-codex",
	"version": "0.1.0",
	"description": "ACE (Agent Context Event Protocol) 0.1 bridge for Codex: drives a live `codex app-server` session from external events — an ACE event becomes a turn, a busy session gets steered mid-turn, and manual events are held by the ACE runtime's pending store.",
	"type": "module",
	"private": true,
	"bin": {
		"ace-codex-bridge": "./bin/ace-codex-bridge.ts"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src",
		"bin",
		"README.md"
	],
	"scripts": {
		"test": "vitest --run",
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"smoke": "bun scripts/smoke.ts",
		"build": "tsc -p tsconfig.build.json"
	},
	"keywords": [
		"ace",
		"agent",
		"events",
		"coding-agent",
		"codex",
		"app-server"
	],
	"license": "MIT",
	"dependencies": {
		"ace-runtime": "file:../ace-runtime",
		"ws": "8.18.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@types/ws": "8.18.1",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
