{
	"name": "ace-omp",
	"version": "0.2.15",
	"description": "ACE (Agent Context Event Protocol) 0.1 host plugin for oh-my-pi / Pi: external events (CI results, alerts, peer agents) as an active input to a running coding session.",
	"private": false,
	"type": "module",
	"omp": {
		"extensions": [
			"./extensions/ace.ts"
		]
	},
	"scripts": {
		"test": "vitest --run",
		"check": "biome check --error-on-warnings . && tsc --noEmit && npm run check:contracts",
		"check:contracts": "tsc --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --allowImportingTsExtensions ../../ace-contracts.ts ../../runtime-contracts.ts",
		"verify:omp": "node scripts/verify-omp.ts"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.0.1",
		"@earendil-works/pi-coding-agent": "1.0.1",
		"redis": "6.3.0",
		"typebox": "1.3.27"
	},
	"peerDependencies": {
		"@earendil-works/pi-tui": "^1.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	},
	"keywords": [
		"ace",
		"agent",
		"events",
		"coding-agent",
		"pi",
		"oh-my-pi",
		"redis-streams"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/noexcs/ace-protocol.git",
		"directory": "packages/ace-omp"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
