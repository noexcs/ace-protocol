# The `@deepseek-ai/dsh-*` packages are pinned to the exact host version and listed as peer dependencies:
# at runtime the installing profile provides them, and for local type-checking and tests they are installed
# as dev dependencies. Their own peers are likewise the host's, so npm must not try to resolve the graph by
# installing a second copy of the host — which is also what keeps `npm install` here small and quick.
legacy-peer-deps=true
