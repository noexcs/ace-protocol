{
	"name": "ace-claude-code",
	"version": "0.2.0",
	"description": "ACE (Agent Context Event Protocol) 0.1 for Claude Code: an MCP channel plugin that turns broker events into turns in a live session.",
	"license": "MIT",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "bun install --silent && bun run src/server.ts",
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"test": "vitest --run",
		"smoke": "bun run scripts/smoke.ts"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "1.0.1",
		"@modelcontextprotocol/sdk": "1.26.0",
		"redis": "6.3.0",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.1",
		"typescript": "5.9.3",
		"vitest": "4.1.11"
	}
}
