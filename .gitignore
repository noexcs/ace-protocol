node_modules/
dist/
*.tsbuildinfo

# ace-omp depends on a *committed* copy of the runtime build (file:./vendor/ace-runtime): the omp
# extension loader needs the copy inside the package, so the vendored dist must be tracked. Keep these
# negations after `dist/` so they win.
!packages/ace-omp/vendor/ace-runtime/dist/
!packages/ace-omp/vendor/ace-runtime/dist/**

# ace-dsh imports the same core build by relative path into its own vendored copy, which is therefore
# tracked too; its own output is generated by `npm run build` and stays untracked.
!packages/ace-dsh/vendor/ace-runtime/dist/
!packages/ace-dsh/vendor/ace-runtime/dist/**
packages/ace-dsh/lib/
packages/ace-dsh/dist-package/

# upstream checkouts, kept for integration testing against their sources
pi/
oh-my-pi/

# packaged artifacts
*.tgz

# runtime state (spool files, logs)
.ace/
*.log

.DS_Store
.idea/
